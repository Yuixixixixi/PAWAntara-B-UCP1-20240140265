<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="flex-1 max-w-3xl mx-auto px-4 py-10 w-full">
  <h1 class="text-2xl md:text-3xl font-bold">Tanya AI</h1>
  <p class="text-stone-600 mt-1">Tanya soal jam buka, ongkir, pembayaran, atau stok.</p>

  <section class="mt-6 bg-white border rounded-xl overflow-hidden" aria-label="Ruang obrolan">
    <div id="chatBox" class="p-4 h-80 overflow-y-auto flex flex-col gap-3" aria-live="polite">
      <article class="self-start max-w-[80%] bg-stone-100 rounded-2xl px-4 py-2">
        <p class="text-sm">Halo! Saya asisten Toko Sembako Ariesta. Ada yang bisa dibantu?</p>
      </article>
    </div>
    <form id="chatForm" class="border-t p-4 flex flex-col sm:flex-row gap-3">
      <div class="flex-1">
        <label for="pertanyaan" class="block text-sm font-medium mb-1">Pertanyaan kamu</label>
        <input type="text" id="pertanyaan" name="pertanyaan" required placeholder="contoh: jam buka toko?" class="w-full border rounded-lg px-3 py-2" />
      </div>
      <button type="submit" class="bg-emerald-700 text-white px-5 py-2 rounded-lg sm:self-end">Kirim</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
