<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="flex-1 max-w-6xl mx-auto px-4 py-10 w-full">
  <h1 class="text-2xl md:text-3xl font-bold">Daftar Produk</h1>

  <section class="mt-6" aria-label="Filter produk">
    <form action="/produk" method="GET" class="bg-white border rounded-xl p-4 grid gap-4 sm:grid-cols-3 sm:items-end">
      <div>
        <label for="search" class="block text-sm font-medium">Cari produk</label>
        <input type="text" id="search" name="search" value="<%= search %>" placeholder="contoh: beras" class="mt-1 w-full border rounded-lg px-3 py-2" />
      </div>
      <div>
        <label for="kategori" class="block text-sm font-medium">Kategori</label>
        <select id="kategori" name="kategori" class="mt-1 w-full border rounded-lg px-3 py-2">
          <option value="">Semua kategori</option>
          <% kategoriList.forEach(function (k) { %>
            <option value="<%= k %>" <%= kategori === k ? 'selected' : '' %>><%= k %></option>
          <% }); %>
        </select>
      </div>
      <div class="flex gap-2">
        <button type="submit" class="bg-emerald-700 text-white px-4 py-2 rounded-lg">Terapkan</button>
        <a href="/produk" class="border px-4 py-2 rounded-lg">Reset</a>
      </div>
    </form>
  </section>

  <section class="mt-8" aria-label="Hasil produk">
    <p class="text-sm text-stone-500"><%= products.length %> produk ditemukan</p>
    <% if (products.length === 0) { %>
      <p class="mt-4 bg-amber-50 border border-amber-200 text-amber-800 rounded-lg p-4">Tidak ada produk yang cocok.</p>
    <% } else { %>
      <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <% products.forEach(function (p) { %>
          <article class="bg-white rounded-xl border p-4">
            <span class="text-xs uppercase bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded"><%= p.category %></span>
            <h2 class="mt-2 font-semibold"><%= p.name %></h2>
            <p class="text-emerald-700 font-bold mt-1">Rp <%= p.price.toLocaleString('id-ID') %></p>
            <p class="text-xs text-stone-500 mt-1">Stok: <%= p.stock %> <%= p.unit %></p>
            <a href="/produk/<%= p.id %>" class="mt-3 inline-block text-sm text-emerald-700">Lihat detail &rarr;</a>
          </article>
        <% }); %>
      </div>
    <% } %>
  </section>
</main>
<%- include('partials/footer') %>
