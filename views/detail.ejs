<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="flex-1 max-w-4xl mx-auto px-4 py-10 w-full">
  <nav aria-label="Breadcrumb" class="text-sm text-stone-500">
    <a href="/">Beranda</a> / <a href="/produk">Produk</a> / <span><%= product.name %></span>
  </nav>
  <article class="mt-6 bg-white border rounded-xl p-6">
    <span class="text-xs uppercase bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded"><%= product.category %></span>
    <h1 class="mt-3 text-2xl font-bold"><%= product.name %></h1>
    <p class="mt-2 text-3xl font-bold text-emerald-700">Rp <%= product.price.toLocaleString('id-ID') %></p>
    <p class="mt-2 text-sm"><%= product.stock > 0 ? 'Stok: ' + product.stock + ' ' + product.unit : 'Stok habis' %></p>
    <p class="mt-4 text-stone-600"><%= product.description %></p>
    <a href="/produk" class="mt-6 inline-block border px-4 py-2 rounded-lg">&larr; Kembali</a>
  </article>
</main>
<%- include('partials/footer') %>
