<%- include('partials/head') %>
<%- include('partials/navbar') %>
<main class="flex-1 max-w-6xl mx-auto px-4 py-10 w-full">
  <h1 class="text-2xl md:text-3xl font-bold">Dashboard Admin</h1>
  <p class="text-stone-600 mt-1">Login sebagai <strong><%= user.username %></strong></p>

  <section class="mt-6 grid gap-4 sm:grid-cols-3" aria-label="Ringkasan">
    <div class="bg-white border border-stone-200 rounded-xl p-4"><p class="text-sm text-stone-500">Jumlah Produk</p><p class="text-2xl font-bold"><%= products.length %></p></div>
    <div class="bg-white border border-stone-200 rounded-xl p-4"><p class="text-sm text-stone-500">Total Stok</p><p class="text-2xl font-bold"><%= totalStok %></p></div>
    <div class="bg-white border border-stone-200 rounded-xl p-4"><p class="text-sm text-stone-500">Nilai Stok</p><p class="text-2xl font-bold">Rp <%= nilaiStok.toLocaleString('id-ID') %></p></div>
  </section>

  <section class="mt-8" aria-label="Tambah produk">
    <h2 class="text-xl font-bold">Tambah Produk</h2>
    <form id="formTambah" class="mt-3 bg-white border border-stone-200 rounded-xl p-4 grid gap-3 sm:grid-cols-2">
      <input name="name" placeholder="Nama produk" required class="border border-stone-300 rounded-lg px-3 py-2" />
      <input name="category" placeholder="Kategori" required class="border border-stone-300 rounded-lg px-3 py-2" />
      <input name="price" type="number" placeholder="Harga" required class="border border-stone-300 rounded-lg px-3 py-2" />
      <input name="stock" type="number" placeholder="Stok" required class="border border-stone-300 rounded-lg px-3 py-2" />
      <input name="unit" placeholder="Satuan (pcs)" class="border border-stone-300 rounded-lg px-3 py-2" />
      <input name="description" placeholder="Deskripsi" class="border border-stone-300 rounded-lg px-3 py-2" />
      <button class="sm:col-span-2 bg-emerald-700 text-white px-4 py-2 rounded-lg font-medium hover:bg-emerald-800">Simpan</button>
    </form>
    <p id="pesanForm" class="mt-2 text-sm" role="status"></p>
  </section>

  <section class="mt-8 overflow-x-auto" aria-label="Tabel produk">
    <h2 class="text-xl font-bold">Daftar Produk</h2>
    <table class="mt-3 w-full bg-white border border-stone-200 rounded-xl text-sm">
      <thead class="bg-stone-100 text-left">
        <tr><th class="p-3">ID</th><th class="p-3">Nama</th><th class="p-3">Kategori</th><th class="p-3">Harga</th><th class="p-3">Stok</th><th class="p-3">Aksi</th></tr>
      </thead>
      <tbody id="tabelProduk">
        <% products.forEach(function (p) { %>
          <tr class="border-t border-stone-200" data-id="<%= p.id %>">
            <td class="p-3"><%= p.id %></td>
            <td class="p-3"><%= p.name %></td>
            <td class="p-3"><%= p.category %></td>
            <td class="p-3">Rp <%= p.price.toLocaleString('id-ID') %></td>
            <td class="p-3"><%= p.stock %></td>
            <td class="p-3"><button class="btnHapus text-red-600 hover:underline" data-id="<%= p.id %>">Hapus</button></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </section>
</main>
<script src="/js/dashboard.js"></script>
<%- include('partials/footer') %>
